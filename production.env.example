# Copy these values to the deployment platform's secret manager; do not rename
# this template to an ignored .env file and commit the resulting secrets.
DEPLOY_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Required only for a first-time production bootstrap. Do not commit real values.
PRODUCTION_SEED_CONFIRM=I_UNDERSTAND_PRODUCTION_SEEDING
PRODUCTION_ADMIN_EMAIL=owner@example.com
PRODUCTION_ADMIN_NAME=Store Owner
PRODUCTION_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
PRODUCTION_STORE_ID=primary-store
PRODUCTION_STORE_NAME=Approved store name
PRODUCTION_STORE_ADDRESS=Approved physical address
PRODUCTION_STORE_PHONE=Approved telephone number
PRODUCTION_STORE_TIMEZONE=Africa/Addis_Ababa
PRODUCTION_PICKUP_INTERVAL_MINUTES=20
PRODUCTION_PICKUP_LEAD_MINUTES=20
PRODUCTION_PICKUP_CAPACITY=10
PRODUCTION_STORE_HOURS_JSON={"mon":{"open":"07:00","close":"19:00"},"tue":{"open":"07:00","close":"19:00"},"wed":{"open":"07:00","close":"19:00"},"thu":{"open":"07:00","close":"19:00"},"fri":{"open":"07:00","close":"19:00"},"sat":{"open":"07:00","close":"19:00"},"sun":{"open":"07:00","close":"19:00"}}
PRODUCTION_CATALOG_JSON=[{"name":"Coffee","slug":"coffee","products":[{"name":"Approved product name","price":100}]}]
